NODE_ENV=development
# Port API; frontend (Vite) meneruskan /api ke http://localhost:3000
PORT=3000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/satya

# Minimal 32 karakter. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Pisahkan dengan koma untuk beberapa origin
CORS_ORIGIN=http://localhost:5173
# Alamat frontend, dipakai untuk tautan reset kata sandi di email
APP_URL=http://localhost:5173

# Masa berlaku tautan reset kata sandi (menit)
PASSWORD_RESET_TTL_MINUTES=30

# Masa berlaku tautan verifikasi email pendaftaran (jam)
EMAIL_VERIFICATION_TTL_HOURS=24

# Penguncian akun setelah login gagal berturut-turut (kontrol BSSN 1.4)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Email (reset kata sandi) dikirim lewat Resend: https://resend.com/api-keys
# Kosongkan RESEND_API_KEY saat development: tautan reset dicatat di log server (hanya bila NODE_ENV bukan production).
RESEND_API_KEY=
# Pengirim harus dari domain yang sudah diverifikasi di Resend; onboarding@resend.dev hanya untuk uji
# (hanya bisa mengirim ke email pemilik akun Resend).
MAIL_FROM="SATRIA <onboarding@resend.dev>"

# Worker pengujian (scan): token layanan yang dicocokkan dengan header X-Worker-Token di /internal.
# Wajib diisi agar worker bisa mengambil task. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WORKER_TOKEN=
# Task yang dikunci worker tetapi tak selesai dalam waktu ini (ms) dianggap mati & dikembalikan ke antrean.
WORKER_TASK_TIMEOUT_MS=120000

# Sementara log hanya ditampilkan di terminal. true = juga tulis file JSON harian ke LOG_DIR.
LOG_TO_FILE=false
# Folder log harian (relatif terhadap folder aplikasi, disimpan 14 hari) & level minimal yang dicatat:
# error | warn | info | http | debug. Kosongkan LOG_LEVEL untuk default (production: info, development: debug).
LOG_DIR=logs
LOG_LEVEL=
# Folder penyimpanan bukti gambar (screenshot) yang diunggah worker, relatif terhadap folder aplikasi.
# Disajikan read-only via capability URL /api/v1/evidence/<scanId>/<id>.png (tanpa JWT agar bisa <img>).
EVIDENCE_DIR=evidence

# AI penyusun laporan (ringkasan eksekutif + rekomendasi temuan). Nama env sama dengan worker/.env;
# di server dev disalin otomatis dari worker/.env oleh deploy bila belum ada.
# AI_PROVIDER: gemini | anthropic | none. Kosong = otomatis (gemini dulu, lalu anthropic bila ada kunci).
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Dipakai bila kunci spesifik provider di atas kosong.
AI_API_KEY=
# Kosong = bawaan provider (gemini-3.8-flash / claude-opus-5-5).
AI_MODEL=

# Intel kerentanan (CVE): sinkron NVD + CISA KEV + EPSS + OSV, dicocokkan ke komponen aset.
# Dijalankan berkala oleh `npm run cve:sync` (PM2 satya-sync-cve) atau tombol "Sinkron sekarang" (admin).
# Butuh akses keluar ke services.nvd.nist.gov, www.cisa.gov, api.first.org, api.osv.dev.
# Lewat proxy: isi HTTPS_PROXY=http://proxy:port dan NODE_USE_ENV_PROXY=1.
CVE_SYNC_ENABLED=true
# Kunci API NVD gratis (https://nvd.nist.gov/developers/request-an-api-key): 50 req/30 dtk; tanpa kunci 5 req/30 dtk.
NVD_API_KEY=
CVE_OSV_ENABLED=true
# Email ke pemilik aset bila muncul kecocokan baru yang dieksploitasi aktif (KEV) atau berseveritas kritis.
CVE_NOTIF_EMAIL=true
