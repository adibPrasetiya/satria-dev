		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"d3-force": "^3.0.0",
		"js-yaml": "^5.5.0",
		"jsqr": "1.4.0"
