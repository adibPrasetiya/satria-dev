{
	"name": "satya-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"catalog": "node scripts/build-catalog.mjs",
		"loreng": "node scripts/build-loreng.mjs",
		"login-assets": "node scripts/build-login-assets.mjs",
		"predev": "npm run catalog",
		"prebuild": "npm run catalog",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
