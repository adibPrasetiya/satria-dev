		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-force": "^3.0.10",
		"@types/js-yaml": "^4.0.9",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"mode-watcher": "^1.1.0",
