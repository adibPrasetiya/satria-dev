      },
      "field_sandi": "password",
      "field_unik": ["email", "nrp"],
      "tipe_body": "json",
      "status_sukses": [200, 201, 202]
    }
  },
  "akun_uji": [],
  "metode": [
    {
      "id": "AUTH-1.3-T01",
      "check_id": "auth.password_policy.min_length",
      "titik_uji": "registrasi",
