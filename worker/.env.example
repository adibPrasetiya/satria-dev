# URL API backend SATYA (basis /api/v1). Worker klaim task & kirim hasil ke sini.
BACKEND_URL=http://localhost:3000/api/v1
# Token layanan worker (sama dengan WORKER_TOKEN di backend/.env); header X-Worker-Token.
WORKER_TOKEN=ganti-dengan-token-sama-seperti-backend
# Identitas worker (muncul di scan_tasks.locked_by). Default: worker-<pid>.
WORKER_ID=worker-1
# Engine yang diproses worker ini (pisahkan koma): custom, discovery, zap, playwright, sslyze, nuclei.
# (katana & AI bukan engine terpisah — keduanya sub-tahap di dalam engine 'discovery'.)
# 'nuclei' aman dicantumkan walau biner belum terpasang: task-nya diklaim lalu dilaporkan
# tidak_dapat_diverifikasi (tidak menggantung di antrean).
WORKER_ENGINES=custom,discovery,zap,playwright,sslyze,nuclei
# Jeda polling saat antrean kosong (detik).
POLL_INTERVAL=2

# --- OWASP ZAP (engine zap; opsional) ---
# URL API ZAP (kosongkan bila tak memakai engine zap). Dev: HTTPS via reverse proxy; satu server: http://127.0.0.1:8080
ZAP_BASE_URL=
# API key daemon ZAP (BUKAN WORKER_TOKEN). Tanpa ini, check zap → tidak_dapat_diverifikasi.
ZAP_API_KEY=
ZAP_TIMEOUT_SPIDER=120
ZAP_TIMEOUT_ASCAN=300

# --- Playwright (engine playwright + fallback browser untuk check AUTH/SESS pada SPA/JS) ---
# Library in-proses; butuh venv Python 3.13 dan browser terunduh:
#   .venv/Scripts/python -m playwright install chromium   (server Linux: tambah `install-deps`)
# Tanpa Playwright/browser, check playwright → tidak_dapat_diverifikasi & fallback non-aktif.
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=15000
PLAYWRIGHT_BROWSER=chromium

# --- sslyze (engine sslyze; fungsi Keamanan Komunikasi COMM-8.3/8.4) ---
# Library in-proses (butuh venv Python 3.13; `pip install -r requirements.txt`). Read-only: hanya
# menjabat TLS ke host aset. Tanpa paket sslyze → check sslyze = tidak_dapat_diverifikasi.
# Nonaktifkan dengan SSLYZE_ENABLE=0; selain itu aktif otomatis bila paket ada.
SSLYZE_ENABLE=
# Port TLS default bila URL aplikasi tak menyebut port (default 443).
SSLYZE_PORT=443
# Batas jaringan per koneksi handshake, detik (default 10).
SSLYZE_TIMEOUT=10

# --- katana (penemuan endpoint mendalam; opsional) ---
# Biner Go eksternal (projectdiscovery). Tanpa biner → tahap katana dilewati.
#   go install github.com/projectdiscovery/katana/cmd/katana@latest
KATANA_BIN=katana
# Paksa nonaktif dengan KATANA_ENABLE=0; selain itu aktif otomatis bila biner ada.
KATANA_ENABLE=
KATANA_TIMEOUT=120
KATANA_DEPTH=3
KATANA_MAX=500

# --- ffuf (pengaya recon: penemuan nama parameter query & path tersembunyi; opsional) ---
# Biner Go eksternal. Tanpa biner → tahap ffuf dilewati (recon tetap jalan).
#   go install github.com/ffuf/ffuf/v2@latest
FFUF_BIN=ffuf
# Paksa nonaktif dengan FFUF_ENABLE=0; selain itu aktif otomatis bila biner ada.
FFUF_ENABLE=
# Timeout per-run ffuf (detik). PENTING: ffuf hanya menulis hasil saat SELESAI — bila di-kill timeout,
# keluaran kosong. Jadi wordlist dipangkas (FFUF_WORDLIST_MAXLINES) agar tuntas dalam timeout ini.
FFUF_TIMEOUT=60
FFUF_MAX=40
FFUF_RATE=40
# Batas entri wordlist agar ffuf tuntas dalam FFUF_TIMEOUT (~rate*timeout). 0 = tanpa batas.
FFUF_WORDLIST_MAXLINES=1500
# Maksimum endpoint GET tanpa parameter yang difuzz namanya per discovery (endpoint ber-{id} dilewati).
FFUF_MAKS_ENDPOINT=5
# Anggaran WAKTU TOTAL (detik) tahap penemuan parameter ffuf — bila habis, sisa endpoint dilewati
# (cegah tahap ffuf memblokir pipeline berlama-lama).
FFUF_BUDGET_TOTAL=120
# Wordlist opsional: nama parameter (bawaan: daftar internal) & path (tanpa ini, penemuan path dilewati).
FFUF_WORDLIST_PARAM=
FFUF_WORDLIST_PATH=

# --- nuclei (engine nuclei; fungsi Keamanan API APIS-12.2-T02: paparan dok/debug API) ---
# Biner Go eksternal (projectdiscovery). Tanpa biner → check exposure.api_docs_debug =
# tidak_dapat_diverifikasi (tidak menggantung). Pasang:
#   go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest && nuclei -update-templates
NUCLEI_BIN=nuclei
# Paksa nonaktif dengan NUCLEI_ENABLE=0; selain itu aktif otomatis bila biner ada.
NUCLEI_ENABLE=
NUCLEI_TIMEOUT=90
# Tag template terfokus (dok API/debug) & ambang severity; batasi laju agar sopan ke target.
NUCLEI_TAGS=exposure,swagger,api,config,misconfig,debug
NUCLEI_SEVERITY=low,medium,high,critical
NUCLEI_RATE=50
NUCLEI_CONCURRENCY=25

# --- Enrichment AI discovery (opsional; diimpor lazy) ---
# Peran: deskripsi endpoint, semantik field, narasi alur bisnis. TIDAK memutus lulus/gagal.
# AI_PROVIDER: gemini | anthropic | none. Kosong = auto (gemini dulu, lalu anthropic bila ada kunci).
AI_PROVIDER=gemini
# Kunci API provider. Simpan via vault/secret; JANGAN commit nilainya.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# AI_API_KEY dipakai bila kunci spesifik provider di atas kosong.
AI_API_KEY=
# Model (opsional). Default: gemini-2.5-flash / claude-opus-5-5.
AI_MODEL=
# Samarkan nilai field sensitif (kredensial/token/PII) sebelum dikirim ke AI (default: true).
AI_REDAKSI=true
# Bahasa keluaran enrichment: id | en.
AI_BAHASA=id
# Tie-breaker AI untuk uji Manajemen Sesi (SESS): menajamkan hasil 'tidak_dapat_diverifikasi'
# (logout/token asing/fingerprint/sesi ganda). AI TIDAK memutus lulus/gagal. Mode: hemat | minimal | off.
AI_SESS=hemat
# Berkas cache putusan fingerprint sesi (hemat token saat scan ulang). Default: worker/.cache/ai_sess.json
AI_SESS_CACHE=
# Tie-breaker AI untuk uji Kontrol Akses (ACCS): menajamkan hasil 'tidak_dapat_diverifikasi'
# (IDOR/akses horizontal, privilege vertikal, paparan panel admin, validasi token). AI TIDAK memutus
# lulus/gagal. Mode: hemat | minimal | off.
AI_ACCS=hemat
# Berkas cache klasifikasi antarmuka admin (hemat token saat scan ulang). Default: worker/.cache/ai_accs.json
AI_ACCS_CACHE=
# Penajam AI untuk uji Keamanan Komunikasi (COMM): klasifikasi penerbit sertifikat → PSrE Komdigi
# (COMM-8.4-T03, info) & adjudikasi kecocokan nama host yang ambigu (COMM-8.4-T01). AI TIDAK memutus
# lulus/gagal; hasil sslyze tetap otoritatif. Mode: hemat | minimal | off.
AI_COMM=hemat
# Berkas cache klasifikasi penerbit→PSrE (stabil per host). Default: worker/.cache/ai_comm.json
AI_COMM_CACHE=
# Penajam AI untuk uji Keamanan API (APIS): klasifikasi endpoint publik vs seharusnya-terlindungi
# (APIS-12.3-T01, kurangi positif palsu) & adjudikasi paparan dok/debug (APIS-12.2-T02). AI TIDAK
# memutus lulus/gagal. Mode: hemat | minimal | off.
AI_APIS=hemat
# Berkas cache klasifikasi endpoint publik (stabil per metode+path). Default: worker/.cache/ai_apis.json
AI_APIS_CACHE=
# Penajam AI untuk uji Penanganan Error & Log (ERRL): adjudikasi kebocoran detail teknis pada
# respons error (ERRL-6.1-T01/6.2-T01) & paparan file log (ERRL-6.5-T01). AI TIDAK memutus
# lulus/gagal. Mode: hemat | minimal | off.
AI_ERRL=hemat
# Penajam AI untuk uji Proteksi Data (DATA): adjudikasi paparan berkas cadangan (DATA-7.5-T01) &
# mass-assignment parameter privilese (DATA-7.4-T01). AI TIDAK memutus lulus/gagal. Mode: hemat | minimal | off.
AI_DATA=hemat
# Penajam AI untuk uji File (FILE): adjudikasi hasil unggahan uji (tipe/EICAR/nama, FILE-11.2/11.3/11.4)
# & paparan berkas konfig/sumber (FILE-11.5-T02). AI TIDAK memutus lulus/gagal. Mode: hemat | minimal | off.
AI_FILE=hemat
# Penajam AI untuk uji Konfigurasi (CONF): adjudikasi paparan konfigurasi (mode debug, halaman
# default/sampel, berkas .env/.git) pada temuan nuclei. AI TIDAK memutus lulus/gagal. Mode: hemat | minimal | off.
AI_CONF=hemat
# Penajam AI untuk uji Kriptografi (CRYP): adjudikasi paparan rahasia/kunci (CRYP-5.3-T01) pada
# temuan nuclei. AI TIDAK memutus lulus/gagal. Mode: hemat | minimal | off.
AI_CRYP=hemat
# Penajam AI untuk uji Validasi Input (INPV): (1) perkiraan kriteria field ambigu (mis. NIP/NIK/tanggal),
# (2) orkestrasi ADAPTIF — perbaiki payload dasar yang ditolak agar valid sebelum menilai field,
# (3) tafsir kasus 2xx atas input tak valid. AI TIDAK memutus lulus/gagal. Mode: hemat | minimal | off.
AI_INPV=hemat
# Berkas cache profil field INPV (hemat token saat scan ulang). Default: worker/.cache/ai_inpv_profil.json
AI_INPV_CACHE=
# Anggaran panggilan AI orkestrasi adaptif (perbaikan baseline) per scan — jaga biaya saat endpoint banyak.
INPV_AI_MAKS_PANGGILAN=20
# Maksimum percobaan memperbaiki satu baseline sebelum menyerah (ditandai 'payload belum valid').
INPV_BASELINE_MAKS_PERCOBAAN=3
# Batas request sapuan INPV per scan & jeda antar-request (ms).
INPV_MAKS_REQUEST=600
INPV_JEDA_MS=50
# Maksimum endpoint create yang ditulisi penanda pada uji XSS tersimpan (hanya profil intrusif + izin).
INPV_STORED_MAKS=8

# --- Resend Inbound (otomasi reset: AUTH-1.3-T03 & AUTH-1.5-T02) ---
# Worker mendaftar pengguna uji beremail @RESEND_INBOUND_DOMAIN lalu mengambil email reset
# via REST inbound Resend untuk mengekstrak token/link. Simpan RESEND_API_KEY lewat vault/secret,
# JANGAN commit nilainya. Bila kosong → check reset = menunggu tinjauan asesor.
RESEND_API_KEY=
RESEND_INBOUND_DOMAIN=
# RESEND_BASE_URL=https://api.resend.com
# RESEND_POLL_TIMEOUT=60
# RESEND_POLL_INTERVAL=3
